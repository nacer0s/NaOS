# NaOS Makefile — x86_64 UEFI, 100% custom (no GRUB/gnu-efi)
# Bootloader: x86_64-w64-mingw32-gcc (PE+ EFI). Kernel: x86_64-elf-gcc (ELF64).

# Cross tools may live at MSYS2 /opt/cross or git-bash /c/msys64/opt/cross.
# Native Windows make cannot resolve MSYS paths from PATH, so detect explicitly.
export PATH := /opt/cross/bin:/c/msys64/opt/cross/bin:$(PATH)
CROSS_BINDIR := $(shell if [ -x "/opt/cross/bin/x86_64-elf-gcc" ]; then echo "/opt/cross/bin/"; elif [ -x "C:/msys64/opt/cross/bin/x86_64-elf-gcc.exe" ]; then echo "C:/msys64/opt/cross/bin/"; fi)

BUILD      := build
# Version: single source of truth (must stay above all its uses).
VERSION    := 0.2.0
ESP_IMG    := $(BUILD)/NaOS.v$(VERSION).img
ISO_IMG    := $(BUILD)/NaOS.v$(VERSION).iso
EFI_BIN    := $(BUILD)/BOOTX64.EFI
KERN_ELF   := $(BUILD)/KERNEL.ELF

UEFI_CC    := x86_64-w64-mingw32-gcc
UEFI_CFLAGS:= -ffreestanding -mno-red-zone -fno-stack-protector -fno-exceptions \
              -Wall -Wextra -Werror -O2 -std=c11 -Iboot/uefi -Icommon -c
UEFI_LDFLAGS:= -nostdlib -shared -Wl,-dll -Wl,--subsystem,10 -e efi_main

BOOT_SRCS  := boot/uefi/main.c boot/uefi/conout.c boot/uefi/file.c \
              boot/uefi/elf.c boot/uefi/bootutil.c \
              common/serial.c common/cstring.c
BOOT_OBJS  := $(addprefix $(BUILD)/boot/,$(notdir $(BOOT_SRCS:.c=.o)))

CROSS_GCC  := $(CROSS_BINDIR)x86_64-elf-gcc
CROSS_LD   := $(CROSS_BINDIR)x86_64-elf-ld
PROG_CFLAGS:= -ffreestanding -mno-red-zone -mno-mmx -mno-sse -fno-stack-protector \
              -fno-exceptions -Wall -Wextra -Werror -O2 -std=c11 -Ikernel -c
PROG_LD    := progs/user.ld
PROG_SRCS  := progs/hello.c progs/fib.c progs/loop.c progs/crashme.c progs/forkdemo.c progs/fdemo.c
PROG_ELFS  := $(patsubst progs/%.c,$(BUILD)/progs/%.elf,$(PROG_SRCS))
KERN_CFLAGS:= -ffreestanding -mno-red-zone -mno-mmx -mno-sse -fno-stack-protector \
              -fno-exceptions -Wall -Wextra -Werror -Wno-missing-field-initializers \
              -O2 -std=c11 -Ikernel -Icommon -I$(BUILD) -c
KERN_SRCS  := kernel/kmain.c kernel/drv/fb.c kernel/drv/pit.c \
              kernel/drv/ps2_kbd.c kernel/drv/ata.c kernel/drv/rtc.c \
              kernel/drv/acpi.c               kernel/drv/speaker.c kernel/drv/pci.c \
              kernel/drv/ahci.c kernel/drv/blk.c kernel/drv/xhci.c \
              kernel/drv/nvme.c kernel/drv/ramblk.c \
              kernel/drv/usb_kbd.c kernel/drv/e1000.c \
              kernel/net/net.c kernel/net/udp.c kernel/net/dhcp.c \
              kernel/net/tcp.c kernel/net/dns.c kernel/net/update.c \
              kernel/lib/kprintf.c kernel/lib/sha256.c \
              kernel/fs/fat32.c kernel/fs/nafs.c kernel/task.c \
              kernel/cpu/gdt.c kernel/cpu/idt.c kernel/cpu/isr.c \
              kernel/cpu/pic.c kernel/cpu/tss.c \
              kernel/mm/pmm.c kernel/mm/kmalloc.c \
              kernel/mm/vmm.c kernel/mm/cow.c kernel/shell.c \
              kernel/settings.c \
              kernel/user/prog_counter.c kernel/user/prog_ticker.c \
              kernel/user/prog_peek.c \
              common/serial.c common/cstring.c
KERN_ASM   := kernel/entry.asm kernel/cpu/load.asm kernel/cpu/isr.asm
KERN_ASM_OBJS := $(BUILD)/kern/entry.o $(BUILD)/kern/load.o $(BUILD)/kern/stubs.o
KERN_OBJS  := $(addprefix $(BUILD)/kern/,$(notdir $(KERN_SRCS:.c=.o))) \
              $(KERN_ASM_OBJS)
KERN_LD    := kernel/link.ld

VPATH := boot/uefi common kernel kernel/drv kernel/lib kernel/cpu kernel/mm kernel/fs kernel/user kernel/net

# Generated version header (VERSION is defined at the top).
VERSION_H  := $(BUILD)/version.h

$(VERSION_H): FORCE | $(BUILD)
	@{ echo '/* GENERATED by make - do not edit. */'; \
	   echo '#ifndef NAOS_VERSION_H'; \
	   echo '#define NAOS_VERSION_H'; \
	   echo '#define NAOS_VERSION "$(VERSION)"'; \
	   echo "#define NAOS_BUILD \"`date +%Y-%m-%d`\""; \
	   echo '#endif'; } > $(VERSION_H).tmp
	@cmp -s $(VERSION_H).tmp $(VERSION_H) 2>/dev/null || mv $(VERSION_H).tmp $(VERSION_H)
	@rm -f $(VERSION_H).tmp
	@: version stamp refreshed only when the date/version changes

FORCE: ;

.PHONY: FORCE

# Header deps: any shared header change rebuilds its objects.
$(BOOT_OBJS): $(wildcard boot/uefi/*.h common/*.h)
$(KERN_OBJS): $(wildcard kernel/*.h kernel/drv/*.h kernel/lib/*.h kernel/net/*.h common/*.h) $(VERSION_H)

# OVMF auto-detect: winget QEMU share first, then MSYS2 locations
OVMF_CANDS := "C:/Program Files/qemu/share/edk2-x86_64-code.fd" \
              /ucrt64/share/qemu/edk2-x86_64-code.fd \
              /mingw64/share/qemu/edk2-x86_64-code.fd \
              /usr/share/qemu/edk2-x86_64-code.fd
OVMF := $(shell for f in $(OVMF_CANDS); do if [ -f "$$f" ]; then echo "$$f"; break; fi; done)

QEMU := qemu-system-x86_64

.PHONY: all bootloader kernel progs ramdisk nafsdata esp iso run run-iso check clean

all: bootloader kernel progs

bootloader: $(EFI_BIN)

$(BUILD)/boot/%.o: %.c | $(BUILD)
	@mkdir -p $(dir $@)
	$(UEFI_CC) $(UEFI_CFLAGS) $< -o $@

$(EFI_BIN): $(BOOT_OBJS)
	$(UEFI_CC) $(BOOT_OBJS) $(UEFI_LDFLAGS) -o $(EFI_BIN)
	@echo "built: $(EFI_BIN)"

# Console font: DejaVu Sans Mono rasterized at build time (host Pillow).
PY := $(shell if [ -x "/ucrt64/bin/python" ]; then echo "/ucrt64/bin/python"; elif [ -x "C:/msys64/ucrt64/bin/python.exe" ]; then echo "C:/msys64/ucrt64/bin/python.exe"; else echo "python3"; fi)
FONT_TTF := $(shell for f in /ucrt64/share/fonts/TTF/DejaVuSansMono.ttf "C:/msys64/ucrt64/share/fonts/TTF/DejaVuSansMono.ttf"; do if [ -f "$$f" ]; then echo "$$f"; break; fi; done)
FONT_HDR := $(BUILD)/font_bitmap.h
FONT_HDR_SM := $(BUILD)/font_bitmap_small.h

$(FONT_HDR): tools/font_render.py | $(BUILD)
	@if [ -z "$(FONT_TTF)" ]; then echo "ERROR: DejaVuSansMono.ttf not found (pacman -S mingw-w64-ucrt-x86_64-ttf-dejavu)"; exit 1; fi
	"$(PY)" tools/font_render.py --ttf "$(FONT_TTF)" --size 19 --cell-w 12 --cell-h 24 --out $(FONT_HDR)

$(FONT_HDR_SM): tools/font_render.py | $(BUILD)
	@if [ -z "$(FONT_TTF)" ]; then echo "ERROR: DejaVuSansMono.ttf not found (pacman -S mingw-w64-ucrt-x86_64-ttf-dejavu)"; exit 1; fi
	"$(PY)" tools/font_render.py --ttf "$(FONT_TTF)" --size 12 --cell-w 8 --cell-h 16 --tag small --out $(FONT_HDR_SM)

kernel: $(KERN_ELF)

$(BUILD)/kern/fb.o: $(FONT_HDR) $(FONT_HDR_SM)

$(BUILD)/kern/%.o: %.c | $(BUILD)
	@mkdir -p $(dir $@)
	$(CROSS_GCC) $(KERN_CFLAGS) $< -o $@

$(BUILD)/kern/entry.o: kernel/entry.asm | $(BUILD)
	@mkdir -p $(dir $@)
	nasm -f elf64 $< -o $@

$(BUILD)/kern/load.o: kernel/cpu/load.asm | $(BUILD)
	@mkdir -p $(dir $@)
	nasm -f elf64 $< -o $@

$(BUILD)/kern/stubs.o: kernel/cpu/isr.asm | $(BUILD)
	@mkdir -p $(dir $@)
	nasm -f elf64 $< -o $@

$(KERN_ELF): $(KERN_OBJS) $(KERN_LD)
	$(CROSS_GCC) -nostdlib -T $(KERN_LD) $(KERN_OBJS) -lgcc -o $(KERN_ELF)
	@echo "built: $(KERN_ELF)"

progs: $(PROG_ELFS)

$(BUILD)/progs/crt0.o: progs/crt0.asm | $(BUILD)
	@mkdir -p $(dir $@)
	nasm -f elf64 $< -o $@

$(BUILD)/progs/%.elf: progs/%.c $(BUILD)/progs/crt0.o $(PROG_LD) | $(BUILD)
	@mkdir -p $(dir $@)
	$(CROSS_GCC) $(PROG_CFLAGS) $< -o $(BUILD)/progs/$*.o
	$(CROSS_GCC) -nostdlib -T $(PROG_LD) $(BUILD)/progs/crt0.o $(BUILD)/progs/$*.o -o $@
	@echo "built: $@"

$(BUILD):
	mkdir -p $(BUILD)

esp: all nafsdata
	./tools/mkesp.sh $(ESP_IMG)

# NaOS-FS demo image (PROGS + docs) for the `nafs` command.
nafsdata: progs
	mkdir -p $(BUILD)/nafs-stage/PROGS
	cp $(BUILD)/progs/*.elf $(BUILD)/nafs-stage/PROGS/
	printf 'Hello from NaOS-FS!\r\nThis file lives in the NaOS File System demo image.\r\n' > $(BUILD)/nafs-stage/README.TXT
	printf '# NaOS settings mirror for the NaFS demo.\r\nprompt=NaOS\r\n' > $(BUILD)/nafs-stage/SETTINGS.TXT
	"$(PY)" tools/mknafs.py --out $(BUILD)/data.nafs --label NaFSdemo --pad 64 $(BUILD)/nafs-stage

iso: esp
	./tools/mkiso.sh $(ESP_IMG) $(ISO_IMG)

run: esp
	@if [ -z "$(OVMF)" ]; then echo "ERROR: OVMF edk2-x86_64-code.fd not found"; exit 1; fi
	"$(QEMU)" -machine q35 -drive if=pflash,format=raw,unit=0,file="$(OVMF)",readonly=on -drive format=raw,file=$(ESP_IMG) -m 256M -serial stdio

run-iso: iso
	@if [ -z "$(OVMF)" ]; then echo "ERROR: OVMF edk2-x86_64-code.fd not found"; exit 1; fi
	"$(QEMU)" -machine q35 -drive if=pflash,format=raw,unit=0,file="$(OVMF)",readonly=on -cdrom $(ISO_IMG) -m 256M -serial stdio

check:
	./tools/check.sh

clean:
	rm -rf $(BUILD)
